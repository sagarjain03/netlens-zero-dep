# netlens — optional local settings
#
# Copy this file to `.env` and fill in what you want. The whole file is
# optional: with none of it set, every part of the app still works. Node reads
# it natively, so there is no package involved and nothing to install.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit a key.

# ── the doubt box ──────────────────────────────────────────────────────────
#
# Only used by the "not making sense?" box. Without it the box still answers
# from the built-in glossary, which covers 88 terms and never leaves your
# machine — that is the default, and it is not a degraded mode.
#
# A key from https://console.groq.com turns on the part that handles questions
# the glossary cannot. Answers from it are labelled as coming from a model.
GROQ_API_KEY=

# Optional. Any model that Groq serves; this is the default if unset.
# Groq retires models fairly often; a retired one answers 404. List what
# your key can currently reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
NETLENS_ASK_MODEL=openai/gpt-oss-120b
